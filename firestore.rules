rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Safety Net
    // ===============================================================
    match /{document=**} { 
      allow read, write: if false; 
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        // Keep in sync with ADMIN_EMAILS in src/lib/admin.ts
        (request.auth.token.email in ["wachirakelvin5@gmail.com", "taskmolly254@gmail.com"] &&
         request.auth.token.email_verified == true);
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ===============================================================
    // Collection: Users
    // ===============================================================
    match /users/{uid} {
      function isValidUser(data) {
        return data.uid is string && data.uid.size() <= 128 &&
               data.email is string && data.email.size() <= 200 &&
               data.role in ['client', 'tasker', 'admin'];
      }
      function changedKeys() { return incoming().diff(existing()).affectedKeys(); }

      // A user record holds contact details, so only its owner and the admins can read it.
      // Other people see providers through providerProfiles below.
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      // Service categories are granted by an admin when they approve a verification
      // (providerVerifications below), so a new user cannot start with any.
      allow create: if isValidUser(incoming()) && (isAdmin() ||
        (isOwner(uid) && incoming().role in ['client', 'tasker'] &&
         !incoming().keys().hasAny(['services', 'serviceVerifications'])));

      // Owners edit their own details, but cannot change their role, verification status or
      // wallet, and can only drop service categories (to stop offering one), never add them.
      allow update: if incoming().role == existing().role &&
        (!('services' in incoming()) || (incoming().services is list && incoming().services.size() <= 20)) &&
        (!('fcmToken' in incoming()) || (incoming().fcmToken is string && incoming().fcmToken.size() <= 500)) &&
        (isAdmin() || (isOwner(uid) &&
          !changedKeys().hasAny(['serviceVerifications', 'isVerified', 'walletBalance']) &&
          (!changedKeys().hasAny(['services']) ||
            (incoming().services is list && incoming().services.hasOnly(existing().get('services', []))))));
    }

    // Public provider profile: only the fields clients may see (src/lib/providerProfile.ts).
    // The provider keeps it in step with their user record; categories must match the ones an
    // admin granted on that record.
    match /providerProfiles/{uid} {
      function owned() { return get(/databases/$(database)/documents/users/$(uid)).data; }

      allow read: if true;
      allow create, update: if isAdmin() || (isOwner(uid) &&
        owned().role == 'tasker' &&
        incoming().keys().hasOnly(['uid', 'name', 'photo', 'services', 'isOnline', 'updatedAt']) &&
        incoming().uid == uid &&
        incoming().get('name', '') is string && incoming().get('name', '').size() <= 100 &&
        incoming().get('photo', '') is string && incoming().get('photo', '').size() <= 1000 &&
        incoming().get('isOnline', false) is bool &&
        incoming().get('services', []) == owned().get('services', []) &&
        incoming().updatedAt == request.time);
      allow delete: if isAdmin();
    }

    // Provider verification documents (selfie, ID, permit), one per provider and service, with
    // the id "<uid>_<serviceId>". Only the provider and the admins can read them. The provider
    // can only submit them for review; only an admin can mark them verified or rejected.
    match /providerVerifications/{verificationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if isAdmin() || (isSignedIn() &&
        incoming().uid == request.auth.uid &&
        incoming().serviceId is string && incoming().serviceId.size() <= 100 &&
        verificationId == request.auth.uid + '_' + incoming().serviceId &&
        incoming().status == 'pending' &&
        !incoming().keys().hasAny(['reviewedAt', 'reviewedBy', 'rejectionReason']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /taskerProfiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) || isAdmin();
    }

    // ===============================================================
    // Collection: Service Requests
    // Lifecycle (see src/lib/serviceRequests.ts):
    //   pending -> accepted (provider) -> assigned (client confirms)
    //   accepted -> pending (client rejects / provider withdraws)
    //   assigned -> in-progress -> awaiting-confirmation (provider)
    //   awaiting-confirmation -> completed (client signs off)
    //   pending | accepted | assigned -> cancelled (client)
    // ===============================================================
    match /serviceRequests/{requestId} {
      function categories() {
        return ['Cleaning & Domestic', 'Plumbing & Water', 'Electrical & Solar', 'Repairs & Fundi', 'Outdoor & Relocation'];
      }

      function callerProfile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isTasker() {
        return isSignedIn() && callerProfile().role == 'tasker';
      }

      function isValidRequest(data) {
        return data.serviceType is string && data.serviceType.size() <= 100 &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.status in ['pending', 'accepted', 'assigned', 'in-progress', 'awaiting-confirmation', 'completed', 'cancelled'] &&
               (!('budget' in data) || data.budget is number) &&
               (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
               (!('clientPrice' in data) || data.clientPrice is number) &&
               (!('providerPrice' in data) || data.providerPrice is number) &&
               (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
               (!('syncId' in data) || (data.syncId == null || (data.syncId is string && data.syncId.size() <= 128)));
      }

      function changed() { return incoming().diff(existing()).affectedKeys(); }
      function fromTo(from, to) { return existing().status == from && incoming().status == to; }
      function stampedNow(field) { return incoming()[field] == request.time; }
      function isAssignedProvider() { return existing().get('providerId', '') == request.auth.uid; }

      // Open = pending and posted (or reposted) within the last 3 hours.
      function isOpen(data) {
        let posted = data.get('postedAt', data.get('createdAt', null));
        return data.status == 'pending' && posted is timestamp && request.time < posted + duration.value(3, 'h');
      }

      function clientTransition() {
        let previouslyRejected = existing().get('rejectedProviderIds', []);
        return existing().clientId == request.auth.uid && (
          // Edit or repost while still waiting for a pro
          (fromTo('pending', 'pending') &&
            changed().hasOnly(['description', 'budget', 'clientPrice', 'providerPrice', 'postedAt', 'updatedAt']) &&
            (!changed().hasAny(['postedAt']) || stampedNow('postedAt')) &&
            isValidRequest(incoming())) ||
          // Cancel before work starts
          (existing().status in ['pending', 'accepted', 'assigned'] && incoming().status == 'cancelled' &&
            changed().hasOnly(['status', 'cancelledAt', 'updatedAt']) && stampedNow('cancelledAt')) ||
          // Confirm the pro who accepted
          (fromTo('accepted', 'assigned') &&
            changed().hasOnly(['status', 'confirmedAt', 'updatedAt']) && stampedNow('confirmedAt')) ||
          // Reject the pro who accepted: reopen and never offer it to them again
          (fromTo('accepted', 'pending') &&
            changed().hasOnly(['status', 'providerId', 'providerName', 'acceptedAt', 'rejectedProviderIds', 'updatedAt']) &&
            !('providerId' in incoming()) &&
            incoming().rejectedProviderIds.hasAll(previouslyRejected) &&
            incoming().rejectedProviderIds.size() == previouslyRejected.size() + 1 &&
            existing().providerId in incoming().rejectedProviderIds) ||
          // Sign off completed work
          (fromTo('awaiting-confirmation', 'completed') &&
            changed().hasOnly(['status', 'completedAt', 'updatedAt']) && stampedNow('completedAt')) ||
          // Flag a problem with work marked complete (a complaint is filed separately)
          (fromTo('awaiting-confirmation', 'awaiting-confirmation') &&
            changed().hasOnly(['issueReportedAt', 'updatedAt']) && stampedNow('issueReportedAt'))
        );
      }

      function providerTransition() {
        return
          // Accept an open request in one of the provider's categories
          (fromTo('pending', 'accepted') && isOpen(existing()) && isTasker() &&
            existing().clientId != request.auth.uid &&
            !(request.auth.uid in existing().get('rejectedProviderIds', [])) &&
            existing().get('serviceCategory', '') in callerProfile().get('services', []) &&
            incoming().providerId == request.auth.uid &&
            incoming().providerName is string && incoming().providerName.size() <= 100 &&
            changed().hasOnly(['status', 'providerId', 'providerName', 'acceptedAt', 'updatedAt']) &&
            stampedNow('acceptedAt')) ||
          // Withdraw before the client confirms
          (fromTo('accepted', 'pending') && isAssignedProvider() &&
            changed().hasOnly(['status', 'providerId', 'providerName', 'acceptedAt', 'updatedAt']) &&
            !('providerId' in incoming())) ||
          // Start the job
          (fromTo('assigned', 'in-progress') && isAssignedProvider() &&
            changed().hasOnly(['status', 'startedAt', 'updatedAt']) && stampedNow('startedAt')) ||
          // Mark the work done; the client then signs off
          (fromTo('in-progress', 'awaiting-confirmation') && isAssignedProvider() &&
            changed().hasOnly(['status', 'providerCompletedAt', 'updatedAt']) && stampedNow('providerCompletedAt'));
      }

      allow create: if isSignedIn() &&
        incoming().clientId == request.auth.uid &&
        incoming().status == 'pending' &&
        isValidRequest(incoming()) &&
        incoming().get('serviceCategory', '') in categories() &&
        !('providerId' in incoming()) &&
        stampedNow('createdAt') && stampedNow('postedAt') && stampedNow('updatedAt');

      // Providers may browse pending requests; everything else is limited to the two parties.
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.get('providerId', '') == request.auth.uid ||
        isAdmin() ||
        (resource.data.status == 'pending' && isTasker())
      );

      allow update: if isAdmin() ||
        (isSignedIn() && stampedNow('updatedAt') && (clientTransition() || providerTransition()));

      allow delete: if isAdmin() ||
        (isSignedIn() && existing().clientId == request.auth.uid && existing().status in ['pending', 'cancelled']);

      // Chat between the client and the provider of this task (src/lib/taskChat.ts).
      // Both of them and the admins can read; the two of them can write while the task is active.
      // Messages can't be edited or deleted, so the admins always see the full conversation.
      match /messages/{messageId} {
        function task() {
          return get(/databases/$(database)/documents/serviceRequests/$(requestId)).data;
        }
        function isClient() { return isSignedIn() && task().clientId == request.auth.uid; }
        function isProvider() { return isSignedIn() && task().get('providerId', '') == request.auth.uid; }

        allow read: if isAdmin() || isClient() || isProvider();

        allow create: if
          task().status in ['accepted', 'assigned', 'in-progress', 'awaiting-confirmation'] &&
          ((isClient() && request.resource.data.senderRole == 'client') ||
           (isProvider() && request.resource.data.senderRole == 'provider')) &&
          request.resource.data.keys().hasOnly(['senderId', 'senderRole', 'senderName', 'text', 'timestamp']) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.senderName is string && request.resource.data.senderName.size() <= 100 &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 &&
          request.resource.data.timestamp == request.time;

        allow update, delete: if false;
      }
    }

    // ===============================================================
    // Collection: Jobs
    // ===============================================================
    match /jobs/{jobId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.taskerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() || isAdmin();
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.taskerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid || get(/databases/$(database)/documents/jobs/$(jobId)).data.taskerId == request.auth.uid);
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      }
    }

    // Written only by server.ts with the Admin SDK (which skips these rules); no screen in
    // the app writes here, so the open door for signed-out scripts is closed.
    match /unlistedServiceRequests/{requestId} {
      allow read: if isAdmin();
      allow create: if false;
    }

    // ===============================================================
    // M-Pesa records: written only by server.ts (server/paymentRoutes.ts) with the Admin SDK.
    // The client sees their payments, the provider their payouts, admins see all.
    // ===============================================================
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if false;
    }

    match /payouts/{payoutId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.providerId == request.auth.uid);
      allow write: if false;
    }

    match /health-check/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Posts: exactly what src/components/ForumSidebar.tsx sends, with size limits.
    match /forum/{postId} {
      function isValidPost(d) {
        return d.keys().hasOnly(['userId', 'userName', 'naverId', 'userAvatar', 'content', 'topic',
                                 'mentions', 'likes', 'replyToId', 'replyToUser', 'timestamp']) &&
          d.userId == request.auth.uid &&
          d.content is string && d.content.size() > 0 && d.content.size() <= 1000 &&
          d.get('userName', '') is string && d.get('userName', '').size() <= 100 &&
          d.get('naverId', '') is string && d.get('naverId', '').size() <= 20 &&
          d.get('userAvatar', '') is string && d.get('userAvatar', '').size() <= 1000 &&
          d.get('topic', '') is string && d.get('topic', '').size() <= 100 &&
          d.get('mentions', []) is list && d.get('mentions', []).size() <= 20 &&
          d.get('likes', 0) == 0 &&
          (d.get('replyToId', null) == null || (d.replyToId is string && d.replyToId.size() <= 128)) &&
          (d.get('replyToUser', null) == null || (d.replyToUser is string && d.replyToUser.size() <= 100)) &&
          d.timestamp == request.time;
      }
      allow read: if true;
      allow create: if isSignedIn() && isValidPost(incoming());
      // Likes: signed-in users may move the like count by one, and change nothing else.
      allow update: if isSignedIn() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['likes']) &&
        incoming().likes is int && incoming().likes >= 0 &&
        incoming().likes - existing().get('likes', 0) in [-1, 1];
    }

    // Complaints: exactly what src/components/ComplaintModal.tsx sends, filed by the reporter.
    match /complaints/{complaintId} {
      function isValidComplaint(d) {
        return d.keys().hasOnly(['taskId', 'reporterId', 'reporterRole', 'targetId', 'reason', 'comment', 'status', 'timestamp']) &&
          d.reporterId == request.auth.uid &&
          d.reporterRole in ['client', 'tasker'] &&
          d.taskId is string && d.taskId.size() <= 128 &&
          d.targetId is string && d.targetId.size() <= 128 &&
          d.reason is string && d.reason.size() <= 100 &&
          d.comment is string && d.comment.size() > 0 && d.comment.size() <= 1000 &&
          d.status == 'new' &&
          d.timestamp == request.time;
      }
      allow create: if isSignedIn() && isValidComplaint(incoming());
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || resource.data.targetId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    // Old visit events (until 2026-11). Visits are now counted by Cloudflare Web Analytics
    // (src/lib/webAnalytics.ts), so nothing writes here any more; the admin site's visit history
    // reads what was recorded.
    match /analytics/{eventId} {
      allow create, update, delete: if false;
      allow read: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow create: if isAdmin();
    }
  }
}
