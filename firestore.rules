rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Safety Net
    // ===============================================================
    match /{document=**} { 
      allow read, write: if false; 
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        (request.auth.token.email == "wachirakelvin5@gmail.com" && request.auth.token.email_verified == true);
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ===============================================================
    // Collection: Users
    // ===============================================================
    match /users/{uid} {
      function isValidUser(data) {
        return data.uid is string && data.uid.size() <= 128 &&
               data.email is string && data.email.size() <= 200 &&
               data.role in ['client', 'tasker', 'admin'];
      }
      allow get: if isSignedIn();
      allow list: if (resource.data.role == 'tasker') || isAdmin();
      allow create: if (isOwner(uid) || isAdmin()) && isValidUser(incoming());
      allow update: if (isOwner(uid) || isAdmin()) && 
        incoming().role == existing().role &&
        (!('services' in incoming()) || (incoming().services is list && incoming().services.size() <= 20)) &&
        (!('fcmToken' in incoming()) || (incoming().fcmToken is string && incoming().fcmToken.size() <= 500));
    }

    match /taskerProfiles/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) || isAdmin();
    }

    // ===============================================================
    // Collection: Service Requests
    // Lifecycle (see src/lib/serviceRequests.ts):
    //   pending -> accepted (provider) -> assigned (client confirms)
    //   accepted -> pending (client rejects / provider withdraws)
    //   assigned -> in-progress -> awaiting-confirmation (provider)
    //   awaiting-confirmation -> completed (client signs off)
    //   pending | accepted | assigned -> cancelled (client)
    // ===============================================================
    match /serviceRequests/{requestId} {
      function categories() {
        return ['Cleaning & Domestic', 'Plumbing & Water', 'Electrical & Solar', 'Repairs & Fundi', 'Outdoor & Relocation'];
      }

      function callerProfile() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      }

      function isTasker() {
        return isSignedIn() && callerProfile().role == 'tasker';
      }

      function isValidRequest(data) {
        return data.serviceType is string && data.serviceType.size() <= 100 &&
               data.clientId is string && data.clientId.size() <= 128 &&
               data.status in ['pending', 'accepted', 'assigned', 'in-progress', 'awaiting-confirmation', 'completed', 'cancelled'] &&
               (!('budget' in data) || data.budget is number) &&
               (!('location' in data) || (data.location is string && data.location.size() <= 200)) &&
               (!('clientPrice' in data) || data.clientPrice is number) &&
               (!('providerPrice' in data) || data.providerPrice is number) &&
               (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
               (!('syncId' in data) || (data.syncId == null || (data.syncId is string && data.syncId.size() <= 128)));
      }

      function changed() { return incoming().diff(existing()).affectedKeys(); }
      function fromTo(from, to) { return existing().status == from && incoming().status == to; }
      function stampedNow(field) { return incoming()[field] == request.time; }
      function isAssignedProvider() { return existing().get('providerId', '') == request.auth.uid; }

      // Open = pending and posted (or reposted) within the last 3 hours.
      function isOpen(data) {
        let posted = data.get('postedAt', data.get('createdAt', null));
        return data.status == 'pending' && posted is timestamp && request.time < posted + duration.value(3, 'h');
      }

      function clientTransition() {
        let previouslyRejected = existing().get('rejectedProviderIds', []);
        return existing().clientId == request.auth.uid && (
          // Edit or repost while still waiting for a pro
          (fromTo('pending', 'pending') &&
            changed().hasOnly(['description', 'budget', 'clientPrice', 'providerPrice', 'postedAt', 'updatedAt']) &&
            (!changed().hasAny(['postedAt']) || stampedNow('postedAt')) &&
            isValidRequest(incoming())) ||
          // Cancel before work starts
          (existing().status in ['pending', 'accepted', 'assigned'] && incoming().status == 'cancelled' &&
            changed().hasOnly(['status', 'cancelledAt', 'updatedAt']) && stampedNow('cancelledAt')) ||
          // Confirm the pro who accepted
          (fromTo('accepted', 'assigned') &&
            changed().hasOnly(['status', 'confirmedAt', 'updatedAt']) && stampedNow('confirmedAt')) ||
          // Reject the pro who accepted: reopen and never offer it to them again
          (fromTo('accepted', 'pending') &&
            changed().hasOnly(['status', 'providerId', 'providerName', 'acceptedAt', 'rejectedProviderIds', 'updatedAt']) &&
            !('providerId' in incoming()) &&
            incoming().rejectedProviderIds.hasAll(previouslyRejected) &&
            incoming().rejectedProviderIds.size() == previouslyRejected.size() + 1 &&
            existing().providerId in incoming().rejectedProviderIds) ||
          // Sign off completed work
          (fromTo('awaiting-confirmation', 'completed') &&
            changed().hasOnly(['status', 'completedAt', 'updatedAt']) && stampedNow('completedAt')) ||
          // Flag a problem with work marked complete (a complaint is filed separately)
          (fromTo('awaiting-confirmation', 'awaiting-confirmation') &&
            changed().hasOnly(['issueReportedAt', 'updatedAt']) && stampedNow('issueReportedAt'))
        );
      }

      function providerTransition() {
        return
          // Accept an open request in one of the provider's categories
          (fromTo('pending', 'accepted') && isOpen(existing()) && isTasker() &&
            existing().clientId != request.auth.uid &&
            !(request.auth.uid in existing().get('rejectedProviderIds', [])) &&
            existing().get('serviceCategory', '') in callerProfile().get('services', []) &&
            incoming().providerId == request.auth.uid &&
            incoming().providerName is string && incoming().providerName.size() <= 100 &&
            changed().hasOnly(['status', 'providerId', 'providerName', 'acceptedAt', 'updatedAt']) &&
            stampedNow('acceptedAt')) ||
          // Withdraw before the client confirms
          (fromTo('accepted', 'pending') && isAssignedProvider() &&
            changed().hasOnly(['status', 'providerId', 'providerName', 'acceptedAt', 'updatedAt']) &&
            !('providerId' in incoming())) ||
          // Start the job
          (fromTo('assigned', 'in-progress') && isAssignedProvider() &&
            changed().hasOnly(['status', 'startedAt', 'updatedAt']) && stampedNow('startedAt')) ||
          // Mark the work done; the client then signs off
          (fromTo('in-progress', 'awaiting-confirmation') && isAssignedProvider() &&
            changed().hasOnly(['status', 'providerCompletedAt', 'updatedAt']) && stampedNow('providerCompletedAt'));
      }

      allow create: if isSignedIn() &&
        incoming().clientId == request.auth.uid &&
        incoming().status == 'pending' &&
        isValidRequest(incoming()) &&
        incoming().get('serviceCategory', '') in categories() &&
        !('providerId' in incoming()) &&
        stampedNow('createdAt') && stampedNow('postedAt') && stampedNow('updatedAt');

      // Providers may browse pending requests; everything else is limited to the two parties.
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.get('providerId', '') == request.auth.uid ||
        isAdmin() ||
        (resource.data.status == 'pending' && isTasker())
      );

      allow update: if isAdmin() ||
        (isSignedIn() && stampedNow('updatedAt') && (clientTransition() || providerTransition()));

      allow delete: if isAdmin() ||
        (isSignedIn() && existing().clientId == request.auth.uid && existing().status in ['pending', 'cancelled']);
    }

    // ===============================================================
    // Collection: Jobs
    // ===============================================================
    match /jobs/{jobId} {
      allow read: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.taskerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() || isAdmin();
      allow update: if isSignedIn() && (resource.data.clientId == request.auth.uid || resource.data.taskerId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/jobs/$(jobId)).data.clientId == request.auth.uid || get(/databases/$(database)/documents/jobs/$(jobId)).data.taskerId == request.auth.uid);
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid;
      }
    }

    match /unlistedServiceRequests/{requestId} {
      function isValidUnlisted(data) {
        return data.email is string && data.email.size() <= 200 &&
               data.serviceType is string && data.serviceType.size() <= 200;
      }
      allow read: if isAdmin();
      allow create: if isValidUnlisted(incoming()); 
    }

    match /health-check/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /forum/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && 
        incoming().content is string && incoming().content.size() <= 1000 &&
        incoming().userId == request.auth.uid;
    }

    match /complaints/{complaintId} {
      allow create: if isSignedIn() && incoming().timestamp == request.time;
      allow read: if isSignedIn() && (resource.data.reporterId == request.auth.uid || resource.data.targetId == request.auth.uid || isAdmin());
      allow update: if isAdmin();
    }

    match /analytics/{eventId} {
      allow create: if true;
      allow read: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
      allow create: if isAdmin();
    }
  }
}
